[submodule "charybdis"]
	path = charybdis
	url = https://github.com/bastardkb/bastardkb-qmk
# upstream renamed bkb-master -> bkb-master-archive (same tip); keep --remote working
    branch = bkb-master-archive
[submodule "modules/getreuer"]
	path = modules/getreuer
	url = https://github.com/getreuer/qmk-modules.git
[submodule "imprint"]
	path = imprint
	url = https://github.com/Cyboard-DigitalTailor/vial-qmk
    branch = cyboard
[submodule "svalboard"]
	path = svalboard
	url = https://github.com/svalboard/vial-qmk.git
	branch = vial
[submodule "holykeebs_qmk"]
	path = holykeebs_qmk
	url = https://github.com/holykeebs/qmk_firmware.git
